FLASK_ENV=development
SECRET_KEY=change-this-secret-key
# OpenAI API Key — Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
DATABASE_URL=postgresql://banaaiq_user:password@localhost:5432/banaaiq_db

# ── Legacy SMTP (still used by Flask-Mail for contact form) ─────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=iqbaana@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here

# ── Sentry — error monitoring ─────────────────────────────────────────────────
# Sign up at https://sentry.io (free tier), create a Flask project, copy DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set in CI/deploy pipeline to track releases
GIT_COMMIT_SHA=

# ── Email delivery ────────────────────────────────────────────────────────────
# Options: console (dev), smtp, sendgrid, ses
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@banaaiq.com
EMAIL_FROM_NAME=BanaaIQ

# SMTP (generic — for EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# SendGrid (for EMAIL_PROVIDER=sendgrid)
# Sign up at https://sendgrid.com (free tier: 100 emails/day)
SENDGRID_API_KEY=

# AWS SES (for EMAIL_PROVIDER=ses — recommended for production GCC)
# Region me-south-1 = Bahrain (lowest latency for Saudi Arabia)
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Payment gateway ───────────────────────────────────────────────────────────
# Options: mock (dev/test), razorpay (India), stripe (KSA/international)
PAYMENT_PROVIDER=mock

# Razorpay — India payments (https://razorpay.com — Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe — KSA/international payments (https://dashboard.stripe.com — Developers > API Keys)
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── India — company & GST details (used on GST invoices) ─────────────────────
# Required when PAYMENT_PROVIDER=razorpay or any Indian customer invoice is generated
COMPANY_LEGAL_NAME=BanaaIQ Technologies Private Limited
COMPANY_GSTIN=
COMPANY_ADDRESS_LINE_1=
COMPANY_ADDRESS_LINE_2=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_PIN=
# State code per GST schedule (e.g. 27 for Maharashtra, 07 for Delhi)
COMPANY_STATE_CODE=
